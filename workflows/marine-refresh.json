{
  "id": "marine-refresh-v07",
  "name": "바다결 · 자료 갱신 파이프라인",
  "active": false,
  "nodes": [
    {
      "id": "1",
      "name": "예약 시작",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "수동 확인",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ],
      "parameters": {}
    },
    {
      "id": "3",
      "name": "갱신 필요 확인",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "http://app:8001/internal/sync-status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "marine-sync-auth",
          "name": "Marine Sync API"
        }
      }
    },
    {
      "id": "4",
      "name": "갱신 대상 선택",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "return Object.entries($json.jobs).filter(([kind,s]) => s.due).map(([kind]) => ({json:{kind}}));"
      }
    },
    {
      "id": "5",
      "name": "수집 작업 요청",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "http://app:8001/internal/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({kind:$json.kind,scheduled:$json.scheduled ?? true}) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "marine-sync-auth",
          "name": "Marine Sync API"
        }
      }
    },
    {
      "id": "6",
      "name": "작업 ID 확인",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-job",
              "leftValue": "={{ $json.job_id || \"\" }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "7",
      "name": "작업 ID 유지",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "job",
              "name": "job_id",
              "value": "={{ $json.job_id || $json.id }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false
      }
    },
    {
      "id": "8",
      "name": "완료 대기",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "amount": 5,
        "unit": "seconds"
      },
      "webhookId": "marine-job-poll"
    },
    {
      "id": "9",
      "name": "작업 상태 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "url": "=http://app:8001/internal/jobs/{{ $json.job_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "marine-sync-auth",
          "name": "Marine Sync API"
        }
      }
    },
    {
      "id": "10",
      "name": "완료 여부",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "done",
              "leftValue": "={{ [\"success\",\"warning\",\"failed\",\"interrupted\"].includes($json.status) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "11",
      "name": "검증·저장 결과 확인",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ [\"success\",\"warning\"].includes($json.status) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "12",
      "name": "성공 요약",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2200,
        -80
      ],
      "parameters": {}
    },
    {
      "id": "13",
      "name": "실패 · 기존 자료 보존",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        2200,
        100
      ],
      "parameters": {
        "errorMessage": "자료 갱신 실패 또는 중단. 운영 화면의 정제된 단계 기록을 확인하세요."
      }
    },
    {
      "id": "manual-kind",
      "name": "수동 갱신 선택",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        220
      ],
      "parameters": {
        "jsCode": "return [{json:{kind:'seatrip_sync',scheduled:false}}];"
      }
    }
  ],
