# Optional: the original document stays outside the repository.
MARINE_CREDENTIALS_FILE=C:/path/to/api-credentials.txt
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b-mtp-q8_0
OLLAMA_NUM_CTX=16384
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_FOOT_BASE_URL=https://routing.openstreetmap.de/routed-foot
# Default transit lookup uses the rendered Naver Map UI, without a transit API key.
TRANSIT_PROVIDER=playwright
# Install Chromium: python -m playwright install chromium
# PLAYWRIGHT_BROWSERS_PATH=C:/path/to/playwright-browsers
# Legacy ODsay adapter is used only with TRANSIT_PROVIDER=odsay.
ODSAY_API_KEY=
KOMSA_API_KEY=
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
